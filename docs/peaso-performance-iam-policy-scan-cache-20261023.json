  "implementation": {
    "scope": "Existing analysis_context(snapshot); no reuse between scan contexts or nested distinct snapshots.",
    "keys": "Exact encoded policy strings; JSON and URL-encoded JSON retain their original parser semantics.",
    "values": "Only sealed FrozenDict policy trees; no grants, trust classifications, findings or final access decisions.",
    "bounds": {
      "entries": 256,
      "conservative_admission_charge_bytes": 4194304,
      "character_range": [
        256,
        32768
      ],
      "charge_formula": "512 + 128 * encoded character count",
      "disable_after_consecutive_valid_policy_misses": 64
    },
    "miss_fallback": "After sustained misses the reference map is cleared and decoding continues without dictionary lookups or admission. Limits never suppress policy facts.",
    "public_and_custom_parsers": "document() and ordinary policy_documents() retain independent mutable results. Custom parsers and custom document generators use their original uncached path.",
    "mutable_resource_inputs": "Retain original independent decoding and mutation semantics.",
    "input_immutability": "Cached trees reject mutation; explicit deepcopy produces an independent mutable copy.",
    "concurrency": "ContextVars isolate concurrent scan evaluations; admission accounting is guarded by a per-context lock."
  },
  "other_paths_rechecked": {
    "AWS_requests": "Existing scan-local Future cache already combines identical cloud reads; explicit refresh and credential exchange paths remain fresh.",
    "GCP_requests": "Existing transport-owned cache already combines identical REST reads.",
    "Azure_requests": "Existing scan-owned request map and per-key locks already combine identical reads.",
    "image_analysis": "Existing digest/options/database-bound reuse retained.",
    "artifact_uploads": "Previously merged same-scan exact-byte batching reuse retained."
  },
