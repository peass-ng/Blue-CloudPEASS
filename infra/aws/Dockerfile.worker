FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml /app/
COPY peaso /app/peaso
COPY risk_rules /app/risk_rules
RUN pip install --no-cache-dir . boto3 'PyJWT[crypto]>=2.10' requests google-auth azure-identity azure-mgmt-resource azure-mgmt-subscription azure-mgmt-authorization azure-mgmt-monitor kubernetes \
    && groupadd --gid 10001 peaso && useradd --uid 10001 --gid 10001 --no-create-home peaso
USER 10001:10001
ENTRYPOINT ["python", "-m", "peaso.worker"]
