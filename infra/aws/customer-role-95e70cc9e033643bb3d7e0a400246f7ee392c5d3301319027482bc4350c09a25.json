              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::202533532952:role/hacktricks-cspm-collector"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                }
              }
            }
          ]
        }
      }
